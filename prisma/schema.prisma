// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String        @id @default(cuid())
  name         String
  tableKey     String        @unique @map("table_key")
  bankType     String        @map("bank_type")
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]
  importLogs   ImportLog[]

  @@map("accounts")
}

model Transaction {
  id              String    @id @default(cuid())
  transactionDate DateTime  @map("transaction_date")
  postDate        DateTime? @map("post_date")
  description     String
  category        String?
  transactionType String?   @map("transaction_type")
  amount          Decimal
  createdAt       DateTime  @default(now()) @map("created_at")
  accountId       String    @map("account_id")
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model MonthlyInsight {
  id          String   @id @default(cuid())
  month       String   @unique       // "YYYY-MM" format, one insight per month
  answer      String?                // cached insights answer from /api/ask-claude (may be null if only groupings have been computed)
  groupings   String?                // cached AI-detected groupings for /api/ask-claude/groupings (JSON array of {name, why, transactionIds})
  totalAmount Decimal  @map("total_amount")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("monthly_insights")
}

model ImportLog {
  id             String   @id @default(cuid())
  accountId      String   @map("account_id")
  fileName       String   @map("file_name")
  totalRecords   Int      @map("total_records")
  imported       Int
  skipped        Int      @default(0)
  earliestDate   DateTime @map("earliest_date")
  latestDate     DateTime @map("latest_date")
  processingTime Int      @map("processing_time")
  importedAt     DateTime @default(now()) @map("imported_at")
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("import_logs")
}
